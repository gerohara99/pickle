extends base

block content
	main.main
		.heading-secondary
			a.label All Users
		.card_container
			each user in users
				.card
					.card__details
						h4.card__sub-heading= `${user.name}`
					.card__data
						svg.card__icon
							use(xlink:href='/img/icons.svg#icon-mail')
						span=user.email
					.card__data
						span=user.role				
					.card__data
						span=user.mobile
					.card__footer
						a.btn.btn--green.btn--small(href=`/users/get/${user._id}`) Edit
						.form__group.right.deleteUserButton
							input#userId.form__input(type='hidden',value=`${user._id}`, name='User Id')
							button.btn.btn--small.btn--green Delete