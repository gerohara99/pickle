extends base

block content

	main
		section(class="section-list")
			div(class="container")
				div(class="users-table")
					p(class="subheading")="USERNAME"
					p(class="subheading")="Email"
					p(class="subheading")="ROLE"
					a(href="/users/create")
						ion-icon(class="subheading" name="add-outline")
					p(class="subheading")=""
					
					each user in users
						div(class="table-row")
							p(class="listItemText")=`${user.name}`
							p(class="listItemText")=`${user.email}`
							p(class="listItemText")=`${user.role}`
							a(href="#" class="deleteUserButtons")
								p(class="userId hiddenField")=`${user._id}`
								ion-icon(class="listItemText actions-icon" name="trash-outline")
							a(href="#" class="editUserButtons")
								ion-icon(class="listItemText actions-icon" name="pencil-outline")
								p(class="userId hiddenField")=`${user._id}`