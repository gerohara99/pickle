extends base

block content 

	main.main
		section(class="section-createEvent")
			div(class="container")
				div(class="createEvent")
					div(class="createEvent-text-box") 
						h1(class="heading-secondary") Create a Pickleball Event

						form(class="createEvent-form")
							div
								label(for="eventName") Event name
								input(name="eventName" type="text" id="eventName" required)
							div
								label(for="eventLocation") Event location
								input(name="eventLocation" type="text" id="eventLocation" required)
							div
								label(for="eventZipCode") Event Type
								input(name="eventZipCode" type="text" id="eventZipCode")
							div 
								label(for="eventDate") Event date
								input(name="eventDate" type="date" id="eventDate" required)
							div 
								label(for="eventStartTime") Event time
								input(name="eventStartTime" type="time" id="eventStartTime" required)
							div 
								label(for="eventOrganiser") Event organiser
								input(name="eventOrganiser" type="text" id="eventOrganiser" required)
							div 
								label(for="eventNumOfPLayers") Number of players in the event
								input(name="eventNumOfPLayers" type="number" id="eventNumOfPlayers" value=`${process.env.NUM_OF_PLAYERS}` required)
							div 
								label(for="eventNumOfStandOuts") Number of players resting per round
								input(name="eventNumOfStandOuts" type="number" id="eventNumOfStandOuts" value=`${process.env.NUM_OF_STANDOUTS}` required)
							div 
								label(for="eventNumOfPairings") Number of pairings per round
								input(name="eventNumOfPairings" type="number" id="eventNumOfPairings"  value=`${process.env.NUM_OF_PAIRINGS}` required)
							div 
								label(for="eventNumOfRounds") Number of rounds in the event
								input(name="eventNumOfRounds" type="number" id="eventNumOfRounds" value=`${process.env.NUM_OF_ROUNDS}` required)

						div(class="button-container")
							div 
								a(class="btn btn--form" id="createEventButton" href="#") Create
							div 
								a(class="btn btn--outline" id="cancelButton" href="/") Cancel

					div(class="createUser-img-box" role="img" aria-label="Picture of a pickle court")