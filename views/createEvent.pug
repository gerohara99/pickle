extends base

block content
  main.main
    .event-view
      .event-view__content
        .event__form-container
          h2.heading-secondary.ma-bt-md Create an Event
          
          form.form.form-event-data
            .form__group
              label.form__label(for='eventName') Event Name
              input#eventName.form__input(type='text', required, name='eventName')
            .form__group
              label.form__label(for='eventLocation') Event Location
              input#eventLocation.form__input(type='text', required, name='eventLocation')
            .form__group
              label.form__label(for='eventDate') Event Date
              input#eventDate.form__input(type='date', required, name='eventDate')
            .form__group
              label.form__label(for='eventStartTime') Event Time
              input#eventStartTime.form__input(type='time', required, name='eventStartTime')

            .form__group.right
              button.btn.btn--small.btn--green Create Event