extends base

block content

	main.main
		section(class="section-acUpdatePassword")
			div(class="container")
				div(class="acUpdatePassword")
					div(class="acUpdatePassword-text-box") 
						h1(class="heading-secondary") Update Your Password

						form(class="acUpdatePassword-form")
							div
								label(for="currentPassword") Current Password
								input(name="currentPassword" type="password" id="currentPassword" required)
							div
								label(for="newPassword") New Password
								input(name="newPassword" type="password" id="newPassword" required)
							div
								label(for="newPasswordConfirm") New Password Confirm
								input(name="newPasswordConfirm" type="password" id="newPasswordConfirm" required)
							p(id="userId" class="hiddenField")=`${user._id}`

						div(class="button-container")
							div 
								a(class="btn btn--form" id="updatePasswordButton" href="#") Update Password
							div 
								a(class="btn btn--form" id="cancelButton" href="/") Cancel

					div(class="acSettings-img-box" role="img" aria-label="Picture of a pickle court")