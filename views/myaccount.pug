extends base

block content

	main.main
		section(class="section-acSettings")
			div(class="container")
				div(class="acSettings")
					div(class="acSettings-text-box") 
						h1(class="heading-secondary") Your Account Settings
						p(class="acSettings-text") Edit Details

						form(class="acSettings-form")
							div 
								label(for='name') Name 
								input(name="name" type="text" id="name" value=`${user.name}` required) 
							div 
								label(for="email") Email
								input(name="name" type="email" placeholder='you@example.com' id="email" value=`${user.email}` required)
							div 
								label(for="mobile") Mobile
								input(name="mobile" type="number" id="mobile" value=`${user.mobile}` required)
						div(class="button-container")
							div 
								a(class="btn btn--form" id="saveAcSettings" href="#") Login
							div 
								a(class="btn btn--form" id="cancelButton" href="/") Cancel

					div(class="login-img-box" role="img" aria-label="Picture of a pickle court")