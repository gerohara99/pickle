extends base

block content
  main.main
    .location-view
      .location-view__content
        .location__form-container
          h2.heading-secondary.ma-bt-md Create a Location
          
          form.form.form-location-data
            .form__group
              label.form__label(for='locationtName') Location Name
              input#locationName.form__input(type='text', required, name='locationName')
            .form__group
              label.form__label(for='locationtNumCourts') Number of courts
              input#locationNumOfCourts.form__input(type='number', required, name='locationNumCourts')
            .form__group
              label.form__label(for='locationtCourtCapacity') Court capacity per players
              input#locationCourtCapacity.form__input(type='number', required, name='locationCourtCapacity')

            .form__group.right
              button.btn.btn--small.btn--green Create Location