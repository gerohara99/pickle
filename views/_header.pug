header.header 

    .header__logo
        img(src='/img/logo-PickleBall.png' alt='Pickle logo')
    nav.nav--user
        if user
            a.nav__el(href='/me')
                span= "Welcome "+ user.name.split(' ')[0]
            a.nav__el.nav__el--logout Log Out
        else
            a.nav__el(href='/login') log in
            a.nav__el.nav__el--cta(href='/signup') Sign up

    nav.nav--bookings 
        a.nav__el(href='#') My Bookings

    nav.nav--manageUsers
        - if (user && user.role === 'clubAdmin')
            a.nav__el(href='#') Manage Users

    nav.nav--manageEvents
        - if (user && user.role === 'clubAdmin')
            a.nav__el(href='/') Manage Events