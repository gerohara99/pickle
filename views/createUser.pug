extends base

block content

	main.main
		section(class="section-createUser")
			div(class="container")
				div(class="createUser")
					div(class="createUser-text-box") 
						h1(class="heading-secondary") Create a user
						p(class="createUser-text") The "go to" place to book all your pickle ball games

						form(class="createUser-form")
							div 
								label.form__label(for='name') Name 
								input(name="name" type="text" id="name" required) 
							div 
								label(for="email") Email
								input(name="name" type="email" placeholder='user@example.com' id="email" required)
							div 
								label(for="mobile") Mobile
								input(name="mobile" type="number" id="mobile" required) 
							div 
								label(for="password") Password
								input(name="Password" type="password" id="password" required) 
							div 
								label(for="passwordConfirm") Re-Type Password
								input(name="passwordConfirm" type="password" id="passwordConfirm" required)
						div(class="button-container")
							div 
								a(class="btn btn--form" id="createUserButton" href="#") Create
							div 
								a(class="btn btn--outline" id="cancelButton" href="/") Cancel

					div(class="createUser-img-box" role="img" aria-label="Picture of a pickle court")