extends base

block content
	main.main
		.heading-secondary
			a.label All Events 
			a.btn--green.btn--small.btn(href=`/events/create`)
		.card_container
			each event in events
				.card
					.card__details
						h4.card__sub-heading= `${event.eventName}`
					.card__data
						svg.card__icon
							use(xlink:href='/img/icons.	svg#icon-map-pin')
						span=event.eventLocation
					.card__data
						svg.card__icon
							use(xlink:href='/img/icons.	svg#icon-calendar')
						span=event.eventDate.toLocaleString('en-GB',{day:'numeric',weekday: 'short', month: 'short'})					
					.card__data
						svg.card__icon
							use(xlink:href='/img/icons.svg#icon-user')
						- const spacesleft =(event.courtCapacity * event.numCourts) - event.bookings.length
						span=`${spacesleft} spaces left`
					.card__data
						svg.card__icon
							use(xlink:href='/img/icons.svg#icon-clock')
						span=`${event.eventStartTime}`
					.card__data
						h4.card__sub-heading= 'Players - '
						span=`${event.bookings}`
					.card__footer
						a.btn.btn--green.btn--small(href=`/events/get/${event._id}`) Edit
						.form__group.right.deleteEventButton
							input#eventId.form__input(type='hidden',value=`${event._id}`, name='Event Id')
							button.btn.btn--small.btn--green Delete