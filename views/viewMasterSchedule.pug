extends base

block content
  main.main
    - const options = {weekday: "short", year: "numeric", month: "short", day: "numeric"};
    - const eventDate = event.eventDate.toLocaleDateString(undefined, options);
    - const nameDateTimeString = `${event.eventName}` + " on " + `${eventDate}` + " @ " + `${event.eventStartTime}` + " in " + `${event.eventLocation}`;
    p.subheading.center-text= nameDateTimeString

    section.section-list
      div.container
        form(method="get" action="" class="filter-form")
          label(for="round") Filter by round:
          select#round(name="round")
            option(value="") All Rounds
            - for (let i = 1; i <= Number(roundsCount); i++)
              option(
                value=i,
                selected=(round == i.toString())
              ) Round #{i}
          button(type="submit") Filter

        // Pagination controls above the table
        include includes/_pagination.pug

        div.mySchedule-table
          each item in paginatedMatches
            - const match = item.match
            - const roundIndex = item.roundIndex
            - const matchIndex = item.matchIndex
            div.table-row
              div.row-pair
                span.label Round :
                span.value= round ? parseInt(round) : roundIndex + 1
              div.row-pair
                span.label Court
                span.value= match.court+1
              div.row-pair
                span.label Team A :
                span.value
                  each player in match.teamA
                    span.listItemText= player.name + ' '
              div.row-pair
                span.label Team B :
                span.value
                  each player in match.teamB
                    span.listItemText= player.name + ' '
              div.row-pair.enter-score-column
                - const hasScore = (typeof match.teamAScore === "number" && match.teamAScore > 0) || (typeof match.teamBScore === "number" && match.teamBScore > 0)
                button.btn.score-button(
                  data-round=round ? parseInt(round)-1 : roundIndex,
                  data-matchindex=matchIndex,
                  data-eventid=event._id,
                  data-teama-score=match.teamAScore,
                  data-teamb-score=match.teamBScore
                )
                  if hasScore
                    | Edit Score
                  else
                    | Enter Score

        // Pagination controls below the table (optional)
        include includes/_pagination.pug

        // Popup Modal for entering scores (only one modal needed)
        div#scoreModal.modal
          div.modal-content
            span.close &times;
            p.subheading Enter Match Score
            form#scoreForm.form-2-cols
              input(type="hidden", name="eventId", id="eventId", value=event._id)
              input(type="hidden", name="roundIndex", id="roundIndex")
              input(type="hidden", name="matchIndex", id="matchIndex")
              div
                label(for="teamAScore") Team A Score:
                input(type="number", name="teamAScore", min="0", id="teamAScore")
              div
                label(for="teamBScore") Team B Score:
                input(type="number", name="teamBScore", min="0", id="teamBScore")
              div
                button(type="submit", class="btn btn--form") Submit Score
   
