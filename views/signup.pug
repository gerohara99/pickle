extends base

block content

	main.main
		section(class="section-signUp")
			div(class="container")
				div(class="signUp")
					div(class="signUp-text-box") 
						h1(class="heading-secondary") Sign Up
						p(class="signUp-text") The "go to" place to book all your pickle ball games

						form(class="signUp-form")
							div 
								label.form__label(for='name') Name 
								input(name="name" type="text" id="name" required) 
							div 
								label(for="email") Email
								input(name="name" type="email" placeholder='you@example.com' id="email" required)
							div 
								label(for="mobile") Mobile
								input(name="mobile" type="number" id="mobile" required) 
							div 
								label(for="password") Password
								input(name="Password" type="password" id="password" required) 
							div 
								label(for="passwordConfirm") Re-Type Password
								input(name="passwordConfirm" type="password" id="passwordConfirm" required)
						div(class="button-container")
							div 
								a(class="btn btn--form" id="signUpButton" href="#") SignUp
							div 
								a(class="btn btn--form" id="cancelButton" href="/") Cancel
					div(class="createUser-img-box" role="img" aria-label="Picture of a pickle court")