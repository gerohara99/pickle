extends base

block content
	main.main
	section(class="section-editUser")
		div(class="container")
			div(class="editUser")
				div(class="editUser-text-box") 
					h1(class="heading-secondary") Edit User
					p(class="editUser-text") The "go to" place to book all your pickle ball games

					form(class="editUser-form")
						div
							label(for='name') Name
							input(id="name" type='text' value=`${user.name}`,required name='name')
						div
							label(for='email') Email address
							input(id="email" type='email' value=`${user.email}` required name='email')
						div
							label(for='mobile') Mobile Phone number
							input(id="mobile" type='number' value=`${user.mobile}` required name='mobile')
						div
							p(id="userId" class="hiddenField")=`${user._id}`
					div(class="button-container")
						div 
							a(class="btn btn--form" id="saveUserButton" href="#") Save
						div 
							a(class="btn btn--outline" id="cancelButton" href="/users/showall") Cancel

				div(class="editUser-img-box" role="img" aria-label="Picture of a pickle court")