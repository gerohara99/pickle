extends base

block content
	main.main

	.user-view__content

		.user-view__form-container
			h2.heading-secondary.ma-bt-md Details
			form.form.form-edit-user-data
				.form__group
					label.form__label(for='name') Name
					input#name.form__input(type='text', value=`${user.name}`, required, name='name')
				.form__group.ma-bt-md
					label.form__label(for='email') Email address
					input#email.form__input(type='email', value=`${user.email}`, required, name='email')
				.form__group.ma-bt-md
					label.form__label(for='mobile') Mobile Phone number
					input#mobile.form__input(type='number', value=`${user.mobile}`, required, name='mobile')
				.form__group
					input#userId.form__input(type='hidden', value=user._id, required, name='User Id')
				.form__group.right
					button.btn.btn--small.btn--green Save settings