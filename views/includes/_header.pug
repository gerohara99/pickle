header.header
    a(href="#")  
        img(class="logo" alt="Pickle ball logo", src='/img/logo.png')

    include _usernameGreeting

    - if (user && userRole ==='clubAdmin')
        include _navLoggedInAsAdmin

    - if (user && userRole  ==='user')
        include _navLoggedInAsUser

    - if (user)
        include _navLogOut