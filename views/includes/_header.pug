header.header
    a(href="#") 
        img(class="logo" alt="Pickle ball logo", src='/img/logo.png')
        
    - const isLoggedIn = true;
    - const userType = "user";

    - if (isLoggedIn && userType ==='admin')
        include _navLoggedInAsAdmin

    - if (isLoggedIn && userType ==='user')
        include _navLoggedInAsUser

    a(class="main-nav-link heading-primary" href="#" id="logOutButton") Logout