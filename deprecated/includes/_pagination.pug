if totalPages > 1
  nav.pagination
    ul.pagination-list
      if currentPage > 1
        li
          a(href=`?page=${currentPage - 1}`) Previous
      - for (var pageNum = 1; pageNum <= totalPages; pageNum++)
        li(class=pageNum === currentPage ? 'active' : '')
          a(href=`?page=${pageNum}`) #{pageNum}
      if currentPage < totalPages
        li
          a(href=`?page=${currentPage + 1}`) Next